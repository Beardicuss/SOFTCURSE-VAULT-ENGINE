<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Win11 Auto-Clean</AssemblyName>
    <RootNamespace>SoftcurseVaultCleaner</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Resources\vault.ico</ApplicationIcon>
  <ApplicationManifest>app.manifest</ApplicationManifest></PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\softcurse_logo.png" />
    <Resource Include="Resources\logo-Photoroom.png" />
    <Content Include="Resources\loader_standby.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\loader_active.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- vault.ico must be in output dir for system tray icon at runtime -->
    <Content Include="Resources\vault.ico">
      <Link>vault.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="LICENSE;NOTICE;PRIVACY.md;SECURITY.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SafeCleanupEngine.Tests\**\*.cs" />
    <Compile Remove="PrivilegedMaintenanceHelper\**\*.cs" />
    <EmbeddedResource Remove="SafeCleanupEngine.Tests\**\*" />
    <EmbeddedResource Remove="PrivilegedMaintenanceHelper\**\*" />
    <None Remove="SafeCleanupEngine.Tests\**\*" />
    <None Remove="PrivilegedMaintenanceHelper\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="PrivilegedMaintenanceHelper\PrivilegedMaintenanceHelper.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <PrivilegedHelperOutputDirectory>PrivilegedMaintenanceHelper\bin\$(Configuration)\$(TargetFramework)\</PrivilegedHelperOutputDirectory>
    <PrivilegedHelperOutputDirectory Condition="'$(RuntimeIdentifier)' != ''">PrivilegedMaintenanceHelper\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</PrivilegedHelperOutputDirectory>
  </PropertyGroup>

  <Target Name="CopyPrivilegedMaintenanceHelper" AfterTargets="Build">
    <ItemGroup>
      <PrivilegedHelperFiles Include="$(PrivilegedHelperOutputDirectory)Softcurse.PrivilegedMaintenanceHelper.exe;
                                      $(PrivilegedHelperOutputDirectory)Softcurse.PrivilegedMaintenanceHelper.dll;
                                      $(PrivilegedHelperOutputDirectory)Softcurse.PrivilegedMaintenanceHelper.deps.json;
                                      $(PrivilegedHelperOutputDirectory)Softcurse.PrivilegedMaintenanceHelper.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PrivilegedHelperFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPrivilegedMaintenanceHelperToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedPrivilegedHelperFiles Include="$(PrivilegedHelperOutputDirectory)Softcurse.PrivilegedMaintenanceHelper.exe;
                                               $(PrivilegedHelperOutputDirectory)Softcurse.PrivilegedMaintenanceHelper.dll;
                                               $(PrivilegedHelperOutputDirectory)Softcurse.PrivilegedMaintenanceHelper.deps.json;
                                               $(PrivilegedHelperOutputDirectory)Softcurse.PrivilegedMaintenanceHelper.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PublishedPrivilegedHelperFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
